{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cclabs.nz/schemas/landscape-manifest.schema.json",
  "title": "OrgIntel Landscape Manifest",
  "description": "Semantic-zoom navigation contract for a future interactive whiteboard viewer. `sf intel map` populates L0 and L1; L2-L4 slots are reserved for the paid mining tier and the viewer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provenance", "levels"],
  "properties": {
    "version": { "const": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "toolVersion", "generatedAt", "orgId"],
      "properties": {
        "tool": { "const": "orgintel" },
        "toolVersion": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "orgId": { "type": "string" }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0_landscape", "L1_domain", "L2_process", "L3_transition", "L4_component"],
      "properties": {
        "L0_landscape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clusters"],
          "properties": {
            "clusters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "objects", "layout", "metrics"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "objects": { "type": "array", "items": { "type": "string" } },
                  "layout": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y"],
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    }
                  },
                  "metrics": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["objects", "automations", "recordCount90d"],
                    "properties": {
                      "objects": { "type": "integer", "minimum": 0 },
                      "automations": { "type": "integer", "minimum": 0 },
                      "recordCount90d": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        "L1_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perCluster"],
          "properties": {
            "perCluster": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["clusterId", "graphRef", "anchorObject", "layout"],
                "properties": {
                  "clusterId": { "type": "string" },
                  "graphRef": { "type": "string" },
                  "anchorObject": { "type": "string" },
                  "layout": {
                    "type": "object",
                    "description": "Precomputed node coordinates keyed by object name.",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["x", "y"],
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "L2_process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perAnchor"],
          "properties": {
            "perAnchor": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["anchorObject", "processGraphRef"],
                "properties": {
                  "anchorObject": { "type": "string" },
                  "processGraphRef": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "L3_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reserved"],
          "properties": { "reserved": { "const": true } }
        },
        "L4_component": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flowSummaryRefs"],
          "properties": {
            "flowSummaryRefs": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
