node_modules/
# Build output only — anchored so it never swallows a source dir named lib/
# (src/lib holds wire.ts). An unanchored `lib/` here silently excluded it once already,
# and the package then built locally from untracked files and failed in CI.
/lib/
/lib-test/
*.js.map
.DS_Store
*.tsbuildinfo
npm-debug.log*

# pnpm
pnpm-debug.log*

# Lock file — use pnpm-lock.yaml; exclude the npm-generated one
package-lock.json

# Test coverage output
coverage/

# Salesforce CLI local state
.sfdx/
.sf/

# Audit report files written to the project root during development
sf-audit-*.html
sf-audit-*.md
sf-audit-*.json
sf-audit-diff-*.html
sf-audit-diff-*.json
sf-audit-history-*.html

# Internal docs and agent artefacts — kept locally, never published.
# Anchored at the root so a nested .gitignore going missing cannot expose them.
CLAUDE.md
DESIGN_BRIEF.md
/docs/superpowers/
/.superpowers/
# Generated audit/intel output — always contains real org data
orgintel-*.html
orgintel-*.json
/coupling-graph.json
/landscape-manifest.json
