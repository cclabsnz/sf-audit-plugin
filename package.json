{
  "name": "@cclabsnz/sf-audit",
  "version": "1.8.0",
  "description": "Salesforce Security Audit — native sf plugin",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit --passWithNoTests",
    "prepack": "npm run build",
    "clean": "rm -rf lib",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@salesforce/core": "^9",
    "@salesforce/sf-plugins-core": "^13",
    "chart.js": "^4.5.1",
    "zod": "^4",
    "@cclabsnz/sf-core": "^0.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30",
    "@types/node": "^26",
    "jest": "^30",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cclabsnz/sf-audit-plugin.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "sf",
    "dirname": "sf",
    "commands": "./lib/commands",
    "pluginType": "jit",
    "flexibleTaxonomy": true,
    "devPlugins": [],
    "topics": {
      "audit": {
        "description": "Salesforce security audit commands",
        "subtopics": {
          "events": {
            "description": "Capture free EventLogFile logs to local disk"
          },
          "apps": {
            "description": "Analyze connected-app least-privilege from EventLogFile usage"
          }
        }
      }
    }
  },
  "files": [
    "/lib",
    "/messages",
    "/config",
    "!/lib/**/*.map"
  ],
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "js-yaml@3": "^3.15.0",
      "handlebars": "^4.7.9",
      "brace-expansion": "^5.0.9",
      "fast-uri@3": "^3.1.5"
    }
  }
}
