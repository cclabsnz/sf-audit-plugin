{
  "name": "@cclabsnz/sf-audit",
  "version": "1.6.0",
  "description": "Salesforce Security Audit — native sf plugin",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --passWithNoTests",
    "test:unit": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js test/unit --passWithNoTests",
    "prepack": "npm run build",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@salesforce/core": "^8",
    "@salesforce/sf-plugins-core": "^12",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^22",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cclabsnz/sf-audit-plugin.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "sf",
    "dirname": "sf",
    "commands": "./lib/commands",
    "pluginType": "jit",
    "flexibleTaxonomy": true,
    "devPlugins": [],
    "topics": {
      "audit": {
        "description": "Salesforce security audit commands",
        "subtopics": {
          "events": {
            "description": "Capture free EventLogFile logs to local disk"
          },
          "apps": {
            "description": "Analyze connected-app least-privilege from EventLogFile usage"
          }
        }
      }
    }
  },
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "js-yaml@3": "^3.15.0",
      "handlebars": "^4.7.9",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.7",
      "fast-uri@3": "^3.1.4"
    }
  },
  "files": [
    "/lib",
    "/messages",
    "/config",
    "/src/assets",
    "!/lib/**/*.map"
  ]
}
