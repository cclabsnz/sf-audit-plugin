{
  "name": "@cclabsnz/sf-audit",
  "version": "1.8.1",
  "description": "Read-only Salesforce security audit for the sf CLI: 88 checks, attack-chain correlation, A-F risk grading, and compliance mapping to OWASP, SOC 2, ISO 27001, NZISM and more.",
  "keywords": [
    "salesforce",
    "salesforce-cli",
    "sf-plugin",
    "sfdx-plugin",
    "oclif-plugin",
    "security",
    "security-audit",
    "security-scanner",
    "compliance",
    "soc2",
    "iso27001",
    "owasp",
    "nzism",
    "agentforce",
    "devsecops",
    "permissions",
    "audit"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:unit": "npm run typecheck && node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit --passWithNoTests",
    "prepack": "npm run build",
    "clean": "rm -rf lib",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests"
  },
  "dependencies": {
    "@cclabsnz/sf-core": "^0.3.0",
    "@oclif/core": "^4",
    "@salesforce/core": "^9",
    "@salesforce/sf-plugins-core": "^13",
    "chart.js": "^4.5.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^26",
    "jest": "^30",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cclabsnz/sf-audit-plugin.git"
  },
  "homepage": "https://github.com/cclabsnz/sf-audit-plugin#readme",
  "bugs": {
    "url": "https://github.com/cclabsnz/sf-audit-plugin/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "sf",
    "dirname": "sf",
    "commands": "./lib/commands",
    "pluginType": "jit",
    "flexibleTaxonomy": true,
    "devPlugins": [],
    "topics": {
      "audit": {
        "description": "Salesforce security audit commands",
        "subtopics": {
          "events": {
            "description": "Capture free EventLogFile logs to local disk"
          },
          "apps": {
            "description": "Analyze connected-app least-privilege from EventLogFile usage"
          }
        }
      }
    }
  },
  "files": [
    "/lib",
    "/messages",
    "/config",
    "!/lib/**/*.map"
  ],
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "js-yaml@3": "^3.15.1",
      "handlebars": "^4.7.9",
      "brace-expansion": "^5.0.9",
      "fast-uri@3": "^3.1.5"
    }
  }
}
